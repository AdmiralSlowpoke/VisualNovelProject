    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u041F\u0430\u043D\u043D\u043E\u0447\u043A\u0430 -  \u0431\u0430\u0440\u044B\u0448\u043D\u044F,
    \u0434\u0435\u0432\u0438\u0446\u0430, \u0432\u0435\u0436\u043B\u0438\u0432\u0430\u044F
    \u0444\u043E\u0440\u043C\u0430 \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u044F
    \u0438\u043B\u0438 \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F
    \u043F\u043E \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044E \u043A \u043B\u0438\u0446\u0430\u043C
    \u0436\u0435\u043D\u0441\u043A\u043E\u0433\u043E \u043F\u043E\u043B\u0430, \u043E\u0431\u044B\u0447\u043D\u043E
    \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0435\u043C\u043E\u0435
    \u043A \u0444\u0430\u043C\u0438\u043B\u0438\u0438 \u0438\u043B\u0438 \u0438\u043C\u0435\u043D\u0438"
